# files/etc/tg-ws-proxy.env.example
#
# tg-ws-proxy configuration (sourced by the service runner).
# Lines are shell assignments; keep values quoted.
#
# Notes:
# - TGWS_SECRET must be exactly 32 hex characters.
# - If TGWS_FAKE_TLS_DOMAIN is set, clients will use an ee-secret link (FakeTLS).
#

# Bind address (LAN by default)
TGWS_HOST="192.168.1.1"
TGWS_PORT="1443"

# Secret: 32 hex chars (will be replaced during install)
TGWS_SECRET="PLACEHOLDER_SECRET"

# DC->IP mapping (optional). Can be empty or like this:
TGWS_DC_IPS="2:149.154.167.220 4:149.154.167.220"

# Logging: tg-ws-proxy supports built-in rotation via log-max-mb/log-backups
TGWS_LOG_FILE="/var/log/tg-ws-proxy.log"
TGWS_LOG_MAX_MB="5"
TGWS_LOG_BACKUPS="2"

# Debug logging (-v / --verbose)
TGWS_VERBOSE="false"

# Socket buffer size (--buf-kb)
TGWS_BUF_KB="256"

# WS pool size per DC (--pool-size)
TGWS_POOL_SIZE="4"

# Cloudflare fallback:
# --no-cfproxy disables CF fallback entirely
TGWS_NO_CFPROXY="false"

# Custom CF proxy domains (repeatable --cfproxy-domain)
# Space-separated, e.g.: "a.example.com b.example.com"
TGWS_CFPROXY_DOMAIN=""

# Cloudflare Worker domains (repeatable --cfproxy-worker-domain)
# Space-separated list
TGWS_CFPROXY_WORKER_DOMAIN=""

# Fake TLS (ee-secret): set SNI domain (example: "www.microsoft.com")
# If empty -> normal dd-secret is used.
TGWS_FAKE_TLS_DOMAIN=""

# PROXY protocol v1 (if running behind nginx/haproxy with proxy_protocol enabled)
TGWS_PROXY_PROTOCOL="false"
