# tg-ws-proxy.env.example
#
# Configuration file for tg-ws-proxy (sourced by /usr/libexec/tg-ws-proxy/run.sh).
# Keep values quoted. This is a shell env file.
#
# Notes:
# - TGWS_SECRET must be exactly 32 hex chars.
# - If TGWS_FAKE_TLS_DOMAIN is set, the client link becomes ee-secret (FakeTLS).
# - TGWS_GIT_REF can pin upstream to tag/commit/branch (optional).
#

# Bind address (LAN by default)
TGWS_HOST="192.168.1.1"
TGWS_PORT="1443"

# Secret: 32 hex chars (installer will replace PLACEHOLDER_SECRET on first install)
TGWS_SECRET="PLACEHOLDER_SECRET"

# DC->IP mapping (optional). Can be empty or like:
TGWS_DC_IPS="2:149.154.167.220 4:149.154.167.220"

# Logs: tg-ws-proxy supports rotation via log-max-mb/log-backups
TGWS_LOG_FILE="/var/log/tg-ws-proxy.log"
TGWS_LOG_MAX_MB="5"
TGWS_LOG_BACKUPS="2"

# Verbose logging (-v/--verbose)
TGWS_VERBOSE="false"

# Socket buffer size (--buf-kb)
TGWS_BUF_KB="256"

# WS pool size per DC (--pool-size)
TGWS_POOL_SIZE="4"

# Cloudflare fallback
TGWS_NO_CFPROXY="false"
TGWS_CFPROXY_DOMAIN=""
TGWS_CFPROXY_WORKER_DOMAIN=""

# Fake TLS (ee-secret): set SNI domain (example: "www.microsoft.com")
TGWS_FAKE_TLS_DOMAIN=""

# PROXY protocol v1 (if behind nginx/haproxy with proxy_protocol enabled)
TGWS_PROXY_PROTOCOL="false"

# Upstream pinning:
# - Empty -> use upstream HEAD (origin/HEAD)
# - Non-empty -> pin to a specific tag/commit/branch (e.g. "v1.2.3", "a1b2c3d", "main")
TGWS_GIT_REF=""