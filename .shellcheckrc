# ShellCheck configuration for this repository.
# Runtime target is OpenWrt BusyBox ash (not strict POSIX /bin/sh).

shell=sh
external-sources=false

# We intentionally source paths that may not exist in CI (OpenWrt-specific),
# and some source paths are dynamic.
disable=SC1090,SC1091

# BusyBox ash supports 'local' (not POSIX), and we intentionally use 'echo -e'
# for colored output on OpenWrt.
disable=SC3043,SC3037